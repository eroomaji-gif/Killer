-- วิธีใส่: แทนที่บล็อกเดิมตั้งแต่ "-- กำหนดค่าเริ่มต้นไว้ด้านบนสุดของสคริปต์"
-- (บรรทัด ~1209) ถึง createSwitchButton "👻 วิชาสิงกำแพง" (บรรทัด ~1256)
-- สาเหตุเดิม: ตอนปิดมันสั่ง CanCollide = true ให้ "ทุกชิ้น" ของตัวละคร
-- ทั้งที่ปกติแขนขา/อุปกรณ์ตกแต่งปิดชนไว้ ชิ้นส่วนเลยชนกันเอง + ถ้ายังอยู่ในกำแพง/พื้นก็โดนดีดออกจนสั่น
-- ==========================================================
getgenv().Noclip_Active = getgenv().Noclip_Active or false
local noclipConnection = nil
local restoreConnection = nil

local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local player = Players.LocalPlayer

-- ตัดการเชื่อมต่อของสคริปต์รอบก่อน (กันซ้อนตอนรันซ้ำ)
pcall(function()
    if getgenv().Noclip_OldConn then getgenv().Noclip_OldConn:Disconnect() end
    if getgenv().Noclip_OldRestore then getgenv().Noclip_OldRestore:Disconnect() end
end)

-- จำค่า CanCollide เดิมของแต่ละชิ้น เพื่อคืนให้ตรงเป๊ะตอนปิด
local originalCollide = {}

local function setCollisionOff(character)
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            if originalCollide[part] == nil then
                originalCollide[part] = part.CanCollide
            end
            part.CanCollide = false
        end
    end
end

-- เช็คว่าตัวละครยังจมอยู่ในกำแพง/พื้นอยู่ไหม
local function isStuckInside(character)
    local ok, cf, size = pcall(function() return character:GetBoundingBox() end)
    if not ok then return false end

    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { character }

    local box = Vector3.new(size.X * 0.7, size.Y * 0.8, size.Z * 0.7)
    for _, p in ipairs(workspace:GetPartBoundsInBox(cf, box, params)) do
        if p.CanCollide
            and not (p.Parent and p.Parent:FindFirstChildOfClass("Humanoid")) then -- ข้ามตัวผู้เล่น/NPC อื่น
            return true
        end
    end
    return false
end

local function restoreCollision()
    for part, original in pairs(originalCollide) do
        if part and part.Parent then
            part.CanCollide = original
        end
    end
    originalCollide = {}

    -- เคลียร์แรงที่ค้าง แล้วให้ตัวละครลุกกลับสภาพปกติ
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local hum = character and character:FindFirstChildOfClass("Humanoid")
    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
    if hum then
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
end

-- ฟังก์ชันเปิด/ปิด No-clip
local function toggleNoclip(state)
    -- ยกเลิกลูปคืนค่าที่ค้างอยู่ (ถ้ามี)
    if restoreConnection then
        restoreConnection:Disconnect()
        restoreConnection = nil
    end

    if state then
        if noclipConnection then noclipConnection:Disconnect() end
        noclipConnection = RunService.Stepped:Connect(function()
            local character = player.Character
            if character then
                setCollisionOff(character)
            end
        end)
        getgenv().Noclip_OldConn = noclipConnection
    else
        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end

        -- ปิดแบบปลอดภัย: ถ้ายังจมในกำแพง/พื้น ให้ค้างโนคลิปไว้จนกว่าจะหลุดออกมา
        -- (สูงสุด 2.5 วินาที ถ้ายังติดอยู่จะยกตัวขึ้นนิดนึงแล้วคืนค่า)
        local startTime = os.clock()
        restoreConnection = RunService.Stepped:Connect(function()
            local character = player.Character
            if not character then
                restoreConnection:Disconnect()
                restoreConnection = nil
                originalCollide = {}
                return
            end

            local timedOut = (os.clock() - startTime) > 2.5
            if isStuckInside(character) and not timedOut then
                setCollisionOff(character) -- ยังอยู่ข้างใน ถือว่าโนคลิปต่อไปก่อน
            else
                if timedOut and isStuckInside(character) then
                    local root = character:FindFirstChild("HumanoidRootPart")
                    if root then
                        root.CFrame = root.CFrame + Vector3.new(0, 5, 0)
                    end
                end
                restoreConnection:Disconnect()
                restoreConnection = nil
                restoreCollision()
            end
        end)
        getgenv().Noclip_OldRestore = restoreConnection
    end
end

-- หากมีการเปิดค้างไว้ก่อนหน้านี้ ให้รันต่อเลยทันที
if getgenv().Noclip_Active then
    toggleNoclip(true)
end

