-- ฟังก์ชันสำหรับสั่งให้ไม้ลอยไปหากองไฟ
local function floatLogToFire(logModel)
    pcall(function()
        if not getgenv().InstantLogFloat_Active then return end
        if not logModel or not logModel.Parent then return end

        local primaryPart = logModel.PrimaryPart or logModel:FindFirstChildWhichIsA("BasePart")
        if not primaryPart then return end

        -- ค้นหากองไฟหลักในแมพ
        local mainFire = workspace:FindFirstChild("MainFire", true) 
            or (workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Campground", true) and workspace.Map.Campground:FindFirstChild("MainFire"))
        
        if not mainFire then return end

        -- (ทางเลือกเสริม): ถ้าเกมต้องใช้รีโมทขอดึงไม้ก่อน ยิงเผื่อไว้ได้เลยครับ (ถ้าไม่ใช้ตัดบรรทัดนี้ออกได้)
        pcall(function()
            local remoteDrag = game:GetService("ReplicatedStorage"):FindFirstChild("RemoteEvents") 
                and game:GetService("ReplicatedStorage").RemoteEvents:FindFirstChild("RequestStartDraggingItem")
            if remoteDrag then
                remoteDrag:FireServer(logModel)
            end
        end)

        -- คำนวณจุดหมาย (เหนือพิกัดกองไฟเล็กน้อย)
        local targetCFrame = mainFire.CFrame + Vector3.new(0, 1, 0)
        
        -- คำนวณความเร็วในการลอยตามระยะทาง
        local distance = (primaryPart.Position - mainFire.Position).Magnitude
        local speedTime = math.clamp(distance / 40, 0.4, 1.2) -- ลอยไวสมูททันใจ
        
        local TweenService = game:GetService("TweenService")
        local tweenInfo = TweenInfo.new(speedTime, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
        local tween = TweenService:Create(primaryPart, tweenInfo, {CFrame = targetCFrame})
        
        tween:Play()
    end)
end

-- ดักจับท่อนไม้ที่เพิ่งเกิดใหม่ใน Workspace (จังหวะที่ตัดต้นไม้เสร็จแล้วไม้ดรอป)
