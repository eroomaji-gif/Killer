            lockConnection = RunService.RenderStepped:Connect(function()
                if getgenv().PositionLock_Active and rootPart.Parent then
                    rootPart.CFrame = CFrame.new(targetPosition)
                    rootPart.AssemblyLinearVelocity = Vector3.zero
                end
            end)
        else
            if lockConnection then
                lockConnection:Disconnect()
                lockConnection = nil
            end
            
            if savedOriginalCFrame then
                rootPart.CFrame = savedOriginalCFrame
                savedOriginalCFrame = nil
            end
        end
    end

    if getgenv().PositionLock_Active then
        pcall(function()
            task.wait(1)
