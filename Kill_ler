-- ==========================================
-- 📌 [ปุ่มฟังก์ชัน] ESP กรอบสี + เสาสูงผู้เล่น (ปุ่มนี้แยกจากปุ่ม "แอบมองเธอ" ใช้ตัวแปรของตัวเอง ไม่ซ้ำกัน)
-- - มีไส้ในของ ESP กรอบสีครบ (Highlight) + เสาสูงเพิ่มให้
-- - อันตราย (มีด/ดาบ/ปืน/ฆาตกร/ฮันเตอร์) = กรอบแดง + ข้างในแดงอ่อน + เสาแดง
-- - Owner = กรอบ + ข้างใน + เสา เป็นสีรุ้ง
-- ครอบด้วย do ... end เพื่อไม่ให้กินโควตา local ของสคริปต์หลัก
-- ==========================================
do
    getgenv().PillarESP_Active = false
    getgenv().PillarESPLines = {}
    getgenv().PillarESPHighlights = {}

    local function clearPillars()
        for _, pillar in pairs(getgenv().PillarESPLines) do
            if pillar then pillar:Destroy() end
        end
        getgenv().PillarESPLines = {}
    end

    local function clearHighlights()
        for _, hl in pairs(getgenv().PillarESPHighlights) do
            if hl then hl:Destroy() end
        end
        getgenv().PillarESPHighlights = {}
    end

    createSwitchButton(ESPContainer, "🗼 ESP กรอบสี + เสา", getgenv().PillarESP_Active, function(isActive)
        getgenv().PillarESP_Active = isActive

        -- ปิดสวิตช์ = ล้างทั้งเสาและกรอบสีของปุ่มนี้
        if not isActive then
            clearPillars()
            clearHighlights()
        end
    end)

    -- ------------------------------------------
    -- เช็คว่าเป็นตัวอันตรายไหม (มีด/ดาบ/ปืน/ฆาตกร/ฮันเตอร์)
    -- ------------------------------------------
    -- (ปืนย้ายไปเป็นของนายอำเภอแล้ว จึงไม่อยู่ในลิสต์นี้)
    local DANGER_WORDS = { "knife", "sword", "murder", "hunter" }

    local function hasDangerWord(text)
        text = string.lower(tostring(text or ""))
        for _, word in ipairs(DANGER_WORDS) do
            if string.find(text, word, 1, true) then
                return true
            end
        end
        return false
    end

    local function hasDangerTool(container)
        if not container then return false end
        for _, item in ipairs(container:GetChildren()) do
            if item:IsA("Tool") and hasDangerWord(item.Name) then
                return true
            end
        end
        return false
    end




    -- ------------------------------------------
    -- 🔵 เช็คนายอำเภอ (Sheriff) ก่อนอย่างอื่นทั้งหมด
    -- ------------------------------------------
    -- ใครถือปืน/รีวอลเวอร์ = นายอำเภอ (ตรงกับ MM2)
    local SHERIFF_WORDS = { "sheriff", "detective", "police", "gun", "revolver" }

    local function hasSheriffWord(text)
        text = string.lower(tostring(text or ""))
        for _, word in ipairs(SHERIFF_WORDS) do
            if string.find(text, word, 1, true) then
                return true
            end
        end
        return false
    end

    local function isSheriff(player)
        -- ชื่อทีม
        if player.Team and hasSheriffWord(player.Team.Name) then
            return true
        end
        -- Attribute บทบาท (ถ้าเกมมี)
        for _, attr in ipairs({ "Role", "role", "Class", "Team" }) do
            local value = player:GetAttribute(attr)
            if value and hasSheriffWord(value) then
                return true
            end
        end
        -- ชื่อ Tool ในมือ/กระเป๋า
        for _, container in ipairs({ player.Character, player:FindFirstChild("Backpack") }) do
            if container then
                for _, item in ipairs(container:GetChildren()) do
                    if item:IsA("Tool") and hasSheriffWord(item.Name) then
                        return true
                    end
                end
            end
        end
        return false
    end

    local function isDangerous(player)
        -- นายอำเภอไม่นับเป็นอันตราย (ต่อให้ถือปืนก็ไม่เป็นแดง)
        if isSheriff(player) then
            return false
        end
        -- ชื่อทีม (เช่น Murderer / Hunter)
        if player.Team and hasDangerWord(player.Team.Name) then
            return true
        end
        -- Attribute บทบาท (ถ้าเกมมี)
        for _, attr in ipairs({ "Role", "role", "Class", "Team" }) do
            local value = player:GetAttribute(attr)
            if value and hasDangerWord(value) then
                return true
            end
        end
        -- อาวุธในมือและในกระเป๋า
        if hasDangerTool(player.Character) or hasDangerTool(player:FindFirstChild("Backpack")) then
            return true
        end
        return false
    end

    -- ------------------------------------------
    -- เช็คสี ESP (ไส้ในจากตัวบน + เพิ่มเช็คอันตรายก่อน)
    -- ------------------------------------------
    local function getESPColor(player)
        if isSheriff(player) then
            return Color3.fromRGB(0, 150, 255) -- 🔵 น้ำเงิน (นายอำเภอ) เช็คก่อนเสมอ
        end
        if isDangerous(player) then
            return Color3.fromRGB(255, 0, 0) -- 🔴 แดง (อันตราย)
        end
        if player.Team and player.Team == localPlayer.Team then
            return Color3.fromRGB(0, 255, 0) -- 🟢 เขียว (พวกเดียวกัน)
        end
        return Color3.fromRGB(255, 255, 255) -- ⚪ ขาว (ทั่วไป)
    end

    -- สีเสา: Owner = สีรุ้ง, คนอื่นใช้ตัวเช็คสีด้านบน
    local function getPillarColor(targetPlayer)
        if targetPlayer == localPlayer then return nil end
        if type(isOwner) == "function" and isOwner(targetPlayer) then
            return "Rainbow"
        end
        return getESPColor(targetPlayer)
    end






    -- ------------------------------------------
    -- ลูป Highlight (ไส้ในตัวบน) ใช้ชื่อ PillarESP_HL แยกจากปุ่มอื่น
    -- ------------------------------------------
    game:GetService("RunService").RenderStepped:Connect(function()
        if not getgenv().PillarESP_Active then return end

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= localPlayer and player.Character then
                local character = player.Character
                if character:FindFirstChild("HumanoidRootPart") then
                    -- ถ้าปุ่ม "แอบมองเธอ" วาดกรอบให้คนนี้อยู่แล้ว ปุ่มนี้ไม่วาดซ้ำ (กันกรอบ 2 ชั้นสลับสีกัน) เหลือแค่เสา
                    if getgenv().Script2_Active and character:FindFirstChild("CustomTeamESP") then
                        local mine = character:FindFirstChild("PillarESP_HL")
                        if mine then mine:Destroy() end
                        continue
                    end

                    local highlight = character:FindFirstChild("PillarESP_HL")
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = "PillarESP_HL"
                        highlight.Adornee = character
                        highlight.OutlineTransparency = 0
                        highlight.FillTransparency = 0.4
                        highlight.Parent = character
                        table.insert(getgenv().PillarESPHighlights, highlight)
                    end

                    if type(isOwner) == "function" and isOwner(player) then
                        -- 👑 Owner = กรอบ + ข้างในสีรุ้ง (เหมือนเสา)
                        local rainbow = Color3.fromHSV(tick() % 5 / 5, 1, 1)
                        highlight.OutlineColor = rainbow
                        highlight.FillColor = rainbow
                        continue
                    end

                    local targetColor = getESPColor(player)
                    highlight.OutlineColor = targetColor
                    if isSheriff(player) then
                        -- กรอบน้ำเงิน + ข้างในน้ำเงินอ่อน
                        highlight.FillColor = Color3.fromRGB(120, 170, 255)
                    elseif isDangerous(player) then
                        -- กรอบแดง + ข้างในแดงอ่อน
                        highlight.FillColor = Color3.fromRGB(255, 120, 120)
                    else
                        highlight.FillColor = targetColor
                    end
                end
            end
        end
    end)

    -- ------------------------------------------
    -- ลูปสร้างเสาและอัปเดตตำแหน่ง (เก็บในโฟลเดอร์แยกใน Workspace ไม่แตะตัวละคร)
    -- ------------------------------------------
    task.spawn(function()
        while true do
            task.wait(0.1)
            pcall(function()
                if not getgenv().PillarESP_Active then
                    clearPillars()
                    return
                end

                local myChar = localPlayer.Character
                if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end

                local folder = workspace:FindFirstChild("CustomPillarESPFolder")
                if not folder then
                    folder = Instance.new("Folder")
                    folder.Name = "CustomPillarESPFolder"
                    folder.Parent = workspace
                end

                local activePlayers = {}
                for _, player in ipairs(Players:GetPlayers()) do
                    if player ~= localPlayer then
                        local targetChar = player.Character
                        if targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
                            activePlayers[player.Name] = true
                            local rootPart = targetChar.HumanoidRootPart

                            local pillarPart = folder:FindFirstChild(player.Name .. "_Pillar")
                            if not pillarPart then
                                pillarPart = Instance.new("Part")
                                pillarPart.Name = player.Name .. "_Pillar"
                                pillarPart.Size = Vector3.new(0.6, 120, 0.6) -- ความสูงเสา
                                pillarPart.Anchored = true
                                pillarPart.CanCollide = false
                                pillarPart.Transparency = 0.3
                                pillarPart.Material = Enum.Material.Neon
                                pillarPart.Parent = folder
                                getgenv().PillarESPLines[player.Name] = pillarPart
                            end

                            pillarPart.CFrame = rootPart.CFrame * CFrame.new(0, 60, 0)

                            local colorResult = getPillarColor(player)
                            if colorResult == "Rainbow" then
                                pillarPart.Color = Color3.fromHSV(tick() % 5 / 5, 1, 1)
                            elseif typeof(colorResult) == "Color3" then
                                pillarPart.Color = colorResult
                            end
                        end
                    end
                end

                -- เคลียร์เสาของคนที่ออกจากเกม/ตัวละครหาย
                for name, pillar in pairs(getgenv().PillarESPLines) do
                    if not activePlayers[name] then
                        if pillar then pillar:Destroy() end
                        getgenv().PillarESPLines[name] = nil
                    end
                end
            end)
        end
    end)
end















-- ==========================================================
-- 🔎 ตัวสแกนสิ่งมีชีวิต (2 สี: เขียว = สัตว์ปลอดภัย / แดง = ที่เหลือทั้งหมด)
-- วิธีใส่: ลบบล็อกสแกนเก่า (บรรทัด ~1264–1364) แล้ววางไฟล์นี้แทน
-- ต้องวางหลัง createSwitchButton และ ContentContainer ถูกสร้างแล้ว
-- ==========================================================
local function createLivingScannerSwitch(parent)
    local Players = game:GetService("Players")
    local lp = Players.LocalPlayer

    local MAX_DISTANCE = 200
    local MAX_HIGHLIGHTS = 30
    local CHECK_INTERVAL = 1.5   -- ยิ่งเยอะยิ่งเบา (วินาทีต่อรอบ)
    local SLICE = 40             -- ตรวจกี่ตัวต่อเฟรม ก่อนพักให้เกมหายใจ

    local GREEN = Color3.fromRGB(80, 255, 120)
    local RED = Color3.fromRGB(255, 60, 60)

    -- 🟢 สัตว์ปลอดภัย (ตีหรือเข้าใกล้ก็ไม่ทำร้ายกลับ) — เพิ่ม/ลบชื่อได้ตามเกม
    local SAFE_KEYWORDS = {
        "deer", "rabbit", "bunny", "chicken", "cow", "pig", "sheep", "goat",
        "fish", "bird", "duck", "butterfly", "frog", "turtle", "squirrel", "horse", "cat", "dog",
    }

    -- ❌ NPC: ไม่สแกนเลย
    local NPC_KEYWORDS = { "npc", "shop", "vendor", "guard", "villager", "merchant", "trader", "quest", "dealer", "seller" }

    local function matchAny(name, list)
        for _, kw in ipairs(list) do
            if string.find(name, kw, 1, true) then
                return true
            end
        end
        return false
    end

    -- ตรวจครั้งเดียวต่อโมเดลแล้วจำผลไว้ (ไม่ต้องคำนวณซ้ำทุกรอบ)
    local function classify(model)
        local name = string.lower(model.Name)
        if matchAny(name, NPC_KEYWORDS)
            or model:FindFirstChildWhichIsA("ProximityPrompt", true)
            or model:FindFirstChildWhichIsA("ClickDetector", true)
            or model:FindFirstChildOfClass("Shirt")
            or model:FindFirstChildOfClass("Pants")
            or model:FindFirstChildOfClass("BodyColors") then
            return "NPC"
        end
        if matchAny(name, SAFE_KEYWORDS) then
            return "Safe"
        end
        return "Danger"
    end

    -- รีเซ็ตสถานะเดิม (กันซ้อนตอนรันสคริปต์ซ้ำ)
    getgenv().CategorizedESP_Active = false
    if getgenv().CategorizedESPHighlights then
        for _, hl in pairs(getgenv().CategorizedESPHighlights) do
            pcall(function() hl:Destroy() end)
        end
    end
    getgenv().CategorizedESPHighlights = {}

    local candidates = {} -- [model] = { kind = nil | "Safe" | "Danger" | "NPC", part = BasePart }
    local addedConn
    local generation = 0

    local function addCandidate(inst)
        if inst:IsA("Humanoid") or inst.Name == "Head" or inst.Name == "Torso" then
            local model = inst.Parent
            if model and model:IsA("Model") and model ~= workspace and not candidates[model] then
                candidates[model] = {}
            end
        end
    end

    local function clearAll()
        for model, hl in pairs(getgenv().CategorizedESPHighlights) do
            pcall(function() hl:Destroy() end)
            getgenv().CategorizedESPHighlights[model] = nil
        end
        candidates = {}
    end

    local function start()
        generation += 1
        local myGen = generation

        addedConn = workspace.DescendantAdded:Connect(function(inst)
            if getgenv().CategorizedESP_Active then
                addCandidate(inst)
            end
        end)

        -- สแกนทั้งแมพครั้งเดียว พักทุก 500 ชิ้นไม่ให้กระตุก
        task.spawn(function()
            local n = 0
            for _, inst in ipairs(workspace:GetDescendants()) do
                if generation ~= myGen or not getgenv().CategorizedESP_Active then return end
                addCandidate(inst)
                n += 1
                if n % 500 == 0 then task.wait() end
            end
        end)
    end

    local function stop()
        generation += 1
        if addedConn then
            addedConn:Disconnect()
            addedConn = nil
        end
        clearAll()
    end

    local function removeHighlight(active, model)
        local hl = active[model]
        if hl then
            pcall(function() hl:Destroy() end)
            active[model] = nil
        end
    end

    -- ลูปเช็คแบบเบา: รอบละ 1.5 วิ + แบ่งตรวจเป็นชุดเล็กๆ
    task.spawn(function()
        while isRunning ~= false do
            task.wait(CHECK_INTERVAL)
            if getgenv().CategorizedESP_Active then
                pcall(function()
                    local character = lp.Character
                    local myRoot = character and character:FindFirstChild("HumanoidRootPart")
                    if not myRoot then return end

                    local myPos = myRoot.Position
                    local active = getgenv().CategorizedESPHighlights
                    local count = 0
                    for _ in pairs(active) do count += 1 end

                    local checked = 0
                    for model, info in pairs(candidates) do
                        checked += 1
                        if checked % SLICE == 0 then
                            task.wait()
                            if not getgenv().CategorizedESP_Active then return end
                        end

                        if not model.Parent then
                            candidates[model] = nil
                            if active[model] then
                                removeHighlight(active, model)
                                count -= 1
                            end
                        elseif info.kind == "NPC" then
                            -- NPC จำไว้แล้ว ข้ามเลย ไม่ต้องคำนวณอีก
                        else
                            -- จำชิ้นส่วนที่ใช้วัดระยะไว้ ไม่ต้องหาใหม่ทุกรอบ
                            local part = info.part
                            if not part or not part.Parent then
                                part = model:FindFirstChild("HumanoidRootPart")
                                    or model:FindFirstChild("Torso")
                                    or model:FindFirstChild("Head")
                                info.part = part
                            end

                            local inRange = part
                                and model ~= character
                                and (myPos - part.Position).Magnitude <= MAX_DISTANCE

                            local hl = active[model]
                            if inRange then
                                if not info.kind then
                                    if Players:GetPlayerFromCharacter(model) then
                                        info.kind = "NPC" -- ผู้เล่น ไม่ต้องสแกน
                                    else
                                        info.kind = classify(model)
                                    end
                                end
                                if info.kind ~= "NPC" and not hl and count < MAX_HIGHLIGHTS then
                                    hl = Instance.new("Highlight")
                                    hl.Name = "CategorizedESP_HL"
                                    hl.Adornee = model
                                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                                    hl.OutlineTransparency = 0
                                    hl.FillTransparency = 0.5
                                    local color = (info.kind == "Safe") and GREEN or RED
                                    hl.FillColor = color
                                    hl.OutlineColor = color
                                    hl.Parent = model
                                    active[model] = hl
                                    count += 1
                                end
                            elseif hl then
                                removeHighlight(active, model)
                                count -= 1
                            end
                        end
                    end
                end)
            end
        end
        stop()
    end)

    -- ผูกกับ Master Header ให้ล้างไฮไลต์ตอนรันสคริปต์ซ้ำ
    local prevCleanup = getgenv().MainScript_Cleanup
    getgenv().MainScript_Cleanup = function()
        getgenv().CategorizedESP_Active = false
        stop()
        if prevCleanup then prevCleanup() end
    end

    return createSwitchButton(ESPContainer, "🔎 สแกนสิ่งมีชีวิต (200m)", false, function(isActive)
        getgenv().CategorizedESP_Active = isActive
        if isActive then
            start()
        else
            stop()
        end
    end)
end

