local function getTargetColorType(targetPlayer)
    local targetChar = targetPlayer.Character
    if not targetChar then return "White" end
    local targetBackpack = targetPlayer:FindFirstChild("Backpack")
    
    -- เช็คมีดในมือหรือในกระเป๋า
    if targetChar:FindFirstChild("Knife") or 
       (targetBackpack and targetBackpack:FindFirstChild("Knife")) then
        return "Red"
    end
    return "GreenOrWhite"
end

