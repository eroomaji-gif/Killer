-- ฟังก์ชันคัดแยกประเภทตามชื่อ (เช็คเขียวก่อน กันสัตว์เป็นมิตรโดนจัดผิด)
local function getEntityCategory(obj)
    local nameLower = string.lower(obj.Name)

    -- 🟢 1. สัตว์เป็นมิตร
    if nameLower:find("deer") or nameLower:find("rabbit") or nameLower:find("bunny") or
       nameLower:find("chicken") or nameLower:find("cow") or nameLower:find("sheep") or
       nameLower:find("pig") or nameLower:find("bird") or nameLower:find("duck") then
        return "PeacefulAnimal"
    end

    -- 🔴 2. มอนสเตอร์ ผี Entity
    if nameLower:find("monster") or nameLower:find("ghost") or nameLower:find("zombie") or
       nameLower:find("killer") or nameLower:find("entity") or nameLower:find("demon") or
       nameLower:find("mutant") or nameLower:find("boss") or nameLower:find("creature") then
        return "Monster"
    end

    -- 🟡 3. สัตว์ที่สู้กลับ (เอา "wild" ออกแล้ว เพราะกว้างเกินไป)
    if nameLower:find("bear") or nameLower:find("wolf") or nameLower:find("boar") or
       nameLower:find("shark") or nameLower:find("spider") then
        return "AggressiveAnimal"
    end

    -- ไม่ตรงชื่อไหนเลย ปัดเป็นแดงไว้ก่อน
    return "Monster"
end

local function applyColors(hl, category)
    if category == "Monster" then
        hl.FillColor = Color3.fromRGB(255, 50, 50)
        hl.OutlineColor = Color3.fromRGB(180, 0, 0)
    elseif category == "AggressiveAnimal" then
        hl.FillColor = Color3.fromRGB(255, 255, 50)
        hl.OutlineColor = Color3.fromRGB(200, 180, 0)
    else
        hl.FillColor = Color3.fromRGB(50, 255, 50)
        hl.OutlineColor = Color3.fromRGB(0, 150, 0)
    end
end

