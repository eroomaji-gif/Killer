local function applyFullBright()
    pcall(function()
        Lighting.ClockTime = 14.0 -- ล็อคเวลาเป็น 14:00 น. (กลางวันแดดจัด)
        Lighting.Brightness = 3 -- เพิ่มความสว่างรวม
        Lighting.GlobalShadows = false -- ปิดเงา
        Lighting.FogStart = 999999
        Lighting.FogEnd = 1000000 -- ดันระยะหมอกออกไปไกลสุดๆ
        Lighting.FogColor = Color3.new(1, 1, 1)
        Lighting.Ambient = Color3.new(1, 1, 1) -- แสงรอบทิศขาวเต็ม ทำให้ไม่มีความมืด
        Lighting.OutdoorAmbient = Color3.new(1, 1, 1)
        Lighting.ExposureCompensation = 0.5
        Lighting.ColorShift_Top = Color3.new(0, 0, 0)
        Lighting.ColorShift_Bottom = Color3.new(0, 0, 0)

        -- ปิดเอฟเฟกต์ที่ทำให้มืด/เบลอ และลบ Atmosphere (ทั้งใน Lighting และ Camera)
        local roots = {Lighting}
        if workspace.CurrentCamera then
            table.insert(roots, workspace.CurrentCamera)
        end
        for _, root in ipairs(roots) do
            for _, v in ipairs(root:GetDescendants()) do
                if v:IsA("Atmosphere") then
                    if not savedEffects[v] then
                        savedEffects[v] = {Density = v.Density, Haze = v.Haze, Glare = v.Glare}
                    end
                    v.Density = 0
                    v.Haze = 0
                    v.Glare = 0
                else
                    for _, cls in ipairs(effectClasses) do
                        if v:IsA(cls) then
                            if savedEffects[v] == nil then
                                savedEffects[v] = {Enabled = v.Enabled}
                            end
                            v.Enabled = false
                        end
                    end
                end
            end
        end
    end)
end

local function restoreLighting()
    pcall(function()
        for prop, val in pairs(originalSettings) do
            Lighting[prop] = val
        end
        for inst, data in pairs(savedEffects) do
            if inst.Parent then
                for k, val in pairs(data) do
                    inst[k] = val
                end
            end
        end
        savedEffects = {}
    end)
end

