            -- ปิดอยู่: เคลียร์ตารางภายในให้ตรงกับที่ปุ่มลบไปแล้ว
            tracked = {}
        else
            pcall(function()
                local character = localPlayer.Character
                local myRoot = character and character:FindFirstChild("HumanoidRootPart")
                if not myRoot then return end

                local myPos = myRoot.Position
                local maxDistance = 200

                -- 1) เก็บกวาด: ลบ Highlight ของตัวที่หาย หรือไกลเกินรัศมี
                for model, hl in pairs(tracked) do
                    local keep = false
                    if model.Parent and hl.Parent then
                        local part = model:FindFirstChild("HumanoidRootPart")
                            or model:FindFirstChild("Torso")
                            or model:FindFirstChild("Head")
                            or model:FindFirstChildWhichIsA("BasePart")
                        if part and (myPos - part.Position).Magnitude <= maxDistance then
                            keep = true
                        end
                    end
                    if not keep then
                        hl:Destroy()
                        tracked[model] = nil
                    end
                end

                -- 2) เพิ่มตัวใหม่ที่ยังไม่มี Highlight
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("Model") and obj ~= character and not tracked[obj] then
                        if not Players:GetPlayerFromCharacter(obj) then
                            local hasBodyPart = obj:FindFirstChild("Head")
                                or obj:FindFirstChild("Humanoid")
                                or obj:FindFirstChild("Torso")

                            if hasBodyPart then
                                local rootPart = obj:FindFirstChild("HumanoidRootPart")
                                    or obj:FindFirstChild("Torso")
                                    or obj:FindFirstChild("Head")
                                    or obj:FindFirstChildWhichIsA("BasePart")

                                if rootPart and (myPos - rootPart.Position).Magnitude <= maxDistance then
                                    local hl = Instance.new("Highlight")
                                    hl.Name = "CategorizedESP_HL"
                                    hl.Adornee = obj
                                    hl.OutlineTransparency = 0
                                    hl.FillTransparency = 0.5
                                    applyColors(hl, getEntityCategory(obj))
                                    hl.Parent = obj

                                    tracked[obj] = hl
                                    table.insert(getgenv().CategorizedESPHighlights, hl)
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)












