                                textLabel.TextStrokeTransparency = 0
                                textLabel.Parent = bill
                                
                                warn("🚨 ตรวจพบคนโกงออโต้: " .. player.Name .. " (" .. reason .. ")")
                            end
                        end
                    end
                end
            end
        end)
    end
end)
