local function instant(prompt)
    prompt.HoldDuration = 0
    -- ถ้าเกมพยายามตั้งค่าดีเลย์กลับ ให้บังคับเป็น 0 ตลอด
    prompt:GetPropertyChangedSignal("HoldDuration"):Connect(function()
        if prompt.HoldDuration ~= 0 then
            prompt.HoldDuration = 0
        end
    end)
end

