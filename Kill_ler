-- ฟังก์ชันตรวจจับปืน/นายอำเภอแบบตรงๆ ชัวร์ 100%
local function checkIsGunHolder(player)
    if not player or player == localPlayer then return false end
    
    -- ถ้ามีฟังก์ชันหลักอยู่แล้วให้เรียกใช้ก่อน
    if type(isSheriffOrGunUser) == "function" and isSheriffOrGunUser(player) then
        return true
    end
    
    -- สำรอง: ตรวจหา Tool ด้วยตัวเองกรณีฟังก์ชันหลักมองไม่เห็น
    local char = player.Character
    local backpack = player:FindFirstChild("Backpack")
    
    local function containsGun(container)
        if not container then return false end
        for _, item in ipairs(container:GetChildren()) do
            if item:IsA("Tool") then
                local name = string.lower(item.Name)
                if name:find("gun") or name:find("revolver") or name:find("sheriff") or name:find("pistol") or name:find("shoot") then
                    return true
                end
            end
        end
        return false
    end
    
    return containsGun(char) or containsGun(backpack)
end

