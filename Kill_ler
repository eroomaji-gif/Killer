local function getMurdererHead()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer and player.Character then
            local char = player.Character
            local hum = char:FindFirstChild("Humanoid")
            local head = char:FindFirstChild("Head")
            local backpack = player:FindFirstChild("Backpack")

            local isMurderer = char:FindFirstChild("Knife") or
                               (backpack and backpack:FindFirstChild("Knife"))

            if isMurderer and hum and hum.Health > 0 and head then
                return head
            end
        end
    end
    return nil
end

-- 2. Hook ดักกระสุน
if not getgenv().SilentAimHooked then
    getgenv().SilentAimHooked = true

    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()

        -- ปล่อยผ่านทันทีถ้าปิดอยู่ หรือเป็นการเรียกจากสคริปต์เรา/ไม่ใช่ Remote ยิง
        if not getgenv().SilentAim_Active
            or checkcaller()
            or (method ~= "FireServer" and method ~= "InvokeServer") then
            return oldNamecall(self, ...)
        end

        -- เช็คชื่อ Remote แบบแคบลง (เฉพาะที่เป็นปืนจริง)
        local remoteName = typeof(self) == "Instance" and self.Name:lower() or ""
        if remoteName ~= "shoot" and remoteName ~= "shootgun" then
            return oldNamecall(self, ...)
        end

        local targetHead = getMurdererHead()
        if not targetHead then
            return oldNamecall(self, ...)
        end

        -- ใช้ table.pack/unpack กัน nil กลาง argument ทำให้ข้อมูลเพี้ยน
        local args = table.pack(...)
        for i = 1, args.n do
            local v = args[i]
            if typeof(v) == "Vector3" then
                args[i] = targetHead.Position
                break
            elseif typeof(v) == "CFrame" then
                args[i] = targetHead.CFrame
                break
            end
        end

        return oldNamecall(self, table.unpack(args, 1, args.n))
    end))
end










